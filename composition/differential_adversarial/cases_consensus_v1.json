{
  "pillar": "consensus",
  "description": "Inputs with a single RFC 8785 canonical form (expect agree: all impls emit the same hash) or that are not valid JSON per RFC 8259 (expect reject: all impls refuse). Where marked, expected_hash is an INDEPENDENT known-answer anchor computed from hand-canonicalized bytes with no JCS library (printf | sha256sum) -- the only check that catches a systematic error shared by all implementations. Full N-way agreement is the property a 2-implementation corpus cannot demonstrate.",
  "cases": [
    {"id": "con-key-order",        "expect": "agree",  "expected_hash": "h:d3626ac30a87e6f7a6428233b3c68299976865fa5508e4267c5415c76af7a772", "raw": "{\"b\":1,\"a\":2}",                       "note": "object keys sorted by UTF-16 code unit"},
    {"id": "con-nested",           "expect": "agree",  "expected_hash": "h:00284ff64ddee4ecd1b3c76fde9524200571a90c53d8c79e5e36e08d8d1d7d1c", "raw": "{\"z\":{\"y\":1,\"x\":2},\"a\":[3,2,1]}", "note": "nested sort; array order preserved"},
    {"id": "con-unicode-nfc",      "expect": "agree",  "expected_hash": "h:2303df0176226e83b89fa2a9311d76a8a4c29b0e8ae83ffaa0e431fa4f8b5359", "raw": "{\"k\":\"café\"}",                    "note": "single-codepoint accented char, byte-preserved"},
    {"id": "con-empty-containers", "expect": "agree",  "expected_hash": "h:aeeba1e56a144077f89e26c930dad7cf933e9383cfb8e33ddff618233b29be76", "raw": "{\"a\":{},\"b\":[]}",                   "note": "empty object and array"},
    {"id": "con-int-zero",         "expect": "agree",  "expected_hash": "h:f3013f933b9fb80ab6d995e7ad9da36f683837ba1d81e950c943d40111eac2f0", "raw": "{\"n\":0}",                            "note": "integer zero"},
    {"id": "con-int-neg",          "expect": "agree",  "expected_hash": "h:fbd5ac2f42479228ed2d3b495816fbda98a9cb9d71d523869a37e784790e9f2c", "raw": "{\"n\":-42}",                          "note": "negative integer"},
    {"id": "con-bool-null",        "expect": "agree",  "expected_hash": "h:58ea9f23c715c4f8fee078efd41139485403f053775482d58b6f4f454b34ecf0", "raw": "{\"a\":true,\"b\":false,\"c\":null}",  "note": "literals"},
    {"id": "con-slash-unescaped",  "expect": "agree",  "expected_hash": "h:ecc3feaa8adfa4b7c1eb932be99c491b2d5b57809c7f54ee82d7fe18c10b14db", "raw": "{\"u\":\"http://a/b\"}",              "note": "forward slash NOT escaped in JCS"},
    {"id": "con-control-tab",      "expect": "agree",  "expected_hash": "h:60f418fd5c538e19fd7dcfb68c4511207ae736b925ff23fc2c8ad6bb6cd2449f", "raw": "{\"s\":\"a\\tb\"}",                    "note": "tab must be \\t"},
    {"id": "con-array-strings",    "expect": "agree",  "expected_hash": "h:b86994baad57fff516a7abb8b44ea4636eede4dd04a41f84573bff0a5a205c0b", "raw": "{\"a\":[\"b\",\"a\",\"c\"]}",          "note": "array element order preserved, not sorted"},
    {"id": "con-large-int-safe",   "expect": "agree",  "expected_hash": "h:91b200a69e4e1a5dc6c33c28c71f9659ff93acae604dcf0abad63c5349db58b0", "raw": "{\"n\":123456789}",                   "note": "integer within 2^53 safe range"},
    {"id": "con-ws-insignificant", "expect": "agree",  "expected_hash": "h:43258cff783fe7036d8a43033f830adfc60ec037382473548ac742b888292777", "raw": "{ \"a\" : 1 , \"b\" : 2 }",            "note": "insignificant whitespace must be stripped -> same as {\"a\":1,\"b\":2}"},
    {"id": "con-empty-object-top", "expect": "agree",  "expected_hash": "h:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a", "raw": "{}",                                 "note": "top-level empty object"},
    {"id": "con-empty-array-top",  "expect": "agree",  "expected_hash": "h:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945", "raw": "[]",                                 "note": "top-level empty array"},
    {"id": "con-string-escapes",   "expect": "agree",  "raw": "{\"s\":\"a\\\"b\\\\c\"}",                                                                                                              "note": "quote + backslash minimally escaped (consensus-checked, KAT via double-parse omitted)"},
    {"id": "con-emoji-value",      "expect": "agree",  "expected_hash": "h:f073f1f05c0a1e01bf604e8ec5f389a64fdeb334e00f9456008269e852b1ff4a", "raw": "{\"k\":\"😀\"}",                    "note": "supplementary-plane char in VALUE emitted as raw UTF-8 (verified RFC 8785 correct across all impls, no \\u-escaping)"},
    {"id": "con-unicode-escape",   "expect": "agree",  "expected_hash": "h:0ca09f1dffb485d259fc791100d48ad7ae9c17f52a2bb07b608c0e28fbca34a1", "raw": "{\"k\":\"\\u00e9\"}",             "note": "\\u00e9 decodes to raw é (verified equal to hand-computed {\"k\":\"é\"} across all impls)"},
    {"id": "con-supp-key-sort",    "expect": "agree",  "expected_hash": "h:28c95d1bbb2209223307e62f489020e8f9e0cfa16adf2daf6d88127a1e8dd22a", "raw": "{\"\\ue000\":1,\"\\ud83d\\ude00\":2}", "note": "RFC 8785 3.2.3 UTF-16 key sort: U+1F600 (high surrogate D83D) sorts BEFORE U+E000. Verified equal to hand-computed UTF-16-correct order across all impls -- NOT a shared codepoint-order bug"},

    {"id": "rej-trailing-comma",   "expect": "reject", "raw": "{\"a\":1,}",                                    "note": "trailing comma is invalid JSON"},
    {"id": "rej-unquoted-key",     "expect": "reject", "raw": "{a:1}",                                         "note": "unquoted object key"},
    {"id": "rej-single-quote",     "expect": "reject", "raw": "{'a':1}",                                       "note": "single-quoted key/string"},
    {"id": "rej-bareword",         "expect": "reject", "raw": "foo",                                           "note": "top-level bareword"},
    {"id": "rej-empty-input",      "expect": "reject", "raw": "",                                              "note": "empty document"},
    {"id": "rej-trailing-garbage", "expect": "reject", "raw": "{\"a\":1}x",                                    "note": "trailing garbage after value"},
    {"id": "rej-unclosed-object",  "expect": "reject", "raw": "{\"a\":1",                                      "note": "unterminated object"},
    {"id": "rej-unclosed-array",   "expect": "reject", "raw": "[1,2",                                          "note": "unterminated array"},
    {"id": "rej-double-value",     "expect": "reject", "raw": "{}{}",                                          "note": "two top-level values"}
  ]
}

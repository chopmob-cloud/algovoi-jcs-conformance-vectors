  "spec": "CAIP-2 / CAIP-10 / CAIP-19 chain-agnostic identifier grammar",
  "spec_authorship": "AlgoVoi-authored adversarial conformance set. Normative reference: ChainAgnostic/CAIPs CAIP-2, CAIP-10, CAIP-19. Negative-testing-first: it pins the malformed, whitespace, Unicode-confusable, delimiter and cross-level inputs a validator MUST reject, plus accept controls to guard against over-rejection, with the two language-dependent regex-anchor traps (Python trailing-newline; JavaScript m-flag line terminators) called out explicitly.",
  "grammar": {
    "chain_id": "namespace ':' reference   namespace [-a-z0-9]{3,8}  reference [-_a-zA-Z0-9]{1,32}",
    "account_id": "chain_id ':' address     address [-.%a-zA-Z0-9]{1,128}",
    "asset_type": "chain_id '/' ns ':' ref   ns [-a-z0-9]{3,8}  ref [-.%a-zA-Z0-9]{1,128}",
    "asset_id": "asset_type '/' token_id     token_id [-.%a-zA-Z0-9]{1,78}"
  },
  "input_encoding": "input_b64 is base64 of the identifier's exact UTF-8 bytes; input_display is a Python repr for humans.",
  "counts": {
    "total": 102,
    "accept": 16,
    "reject": 86,
    "naive_py_caret_dollar_divergences": 3
  },

  "invariants": [
    {
      "id": "key-order-invariance",
      "assert": "delegation_ref(root_envelope) == delegation_ref(root_envelope with keys reordered)",
      "reason": "JCS (RFC 8785) canonicalises key order"
    },
    {
      "id": "chain-integrity",
      "assert": "verify_chain([root_envelope, chain_envelope]) == [root_delegation_ref, chain_delegation_ref]",
      "reason": "each link's prev_delegation_ref equals the prior link's computed ref; a broken link is rejected"
    }
  ]

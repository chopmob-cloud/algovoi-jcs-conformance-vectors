{
  "set": "artifact_ref_v1",
  "schema_version": 1,
  "description": "artifact_ref: deterministic content-addressed reference to an A2A Task output. sha256: + SHA-256(JCS({artifact_type, output_hash, produced_at_ms, task_ref})). Recomputes offline with RFC 8785 + SHA-256, no JWS/JWKS. Transitively binds agent identity + task instruction + output via the task_ref field.",
  "canonicalizer": "rfc8785-jcs + sha256, prefixed 'sha256:'",
  "source_spec": "AlgoVoi-A2A-Artifact (chopmob-cloud); open Apache-2.0 primitive",
  "construction": "artifact_ref = 'sha256:' + SHA-256(JCS({artifact_type, output_hash, produced_at_ms, task_ref}))",
  "jcs_field_order": "artifact_type, output_hash, produced_at_ms, task_ref (lexicographic)",
  "artifact_types": ["DATA", "ERROR", "FILE", "TEXT"],

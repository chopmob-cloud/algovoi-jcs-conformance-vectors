  "published_at": "2026-05-23T20:30:00Z",
  "canonicalizer": "rfc8785@0.1.4 (Python) / canonicalize@3.0.0 (TypeScript) / gowebpki/jcs v1.0.1 (Go) / cyberphone/json-canonicalization (Java) / serde_jcs@0.2.0 (Rust)",
  "hash": "SHA-256, lowercase hex",
  "anchored_to": {
    "primitive": "action_ref = SHA-256(JCS({agent_id, action_type, scope, timestamp_ms}))",
    "scope_field_type": "non-empty string at the canonicalisation layer; no closed enum",
    "convention": "<emitter>:<scope> namespace-prefixing for portable cross-emitter use",
    "spec_authorship": "AlgoVoi-authored; first published in response to AURA's scope-enum question on x402#2332 comment 4526409528"
  },
  "derivation": "Each vector takes a fixed preimage {agent_id: 'agent_alpha', action_type: 'screen', timestamp_ms: 1716494400000} and varies only the scope field. The action_ref hash is SHA-256 of the RFC 8785 canonical bytes of that preimage. Vectors are split into two parallel groups: namespace-prefixed (the recommended portable form) and unprefixed (the collision-risk form). The pair invariants require each prefixed vector to produce a byte-distinct digest from its unprefixed equivalent, proving the namespace prefix is byte-load-bearing in the canonicalisation.",
  "context": {
    "thread": "https://github.com/x402-foundation/x402/issues/2332#issuecomment-4526409528",
    "spec_pr": "https://github.com/x402-foundation/x402/pull/2436",
    "substrate_docs": "https://docs.algovoi.co.uk/canonicalisation-substrate",
    "substrate_packages": {
      "python": "pypi.org/project/algovoi-substrate (>=0.2.1)",
      "typescript": "npmjs.com/package/@algovoi/substrate (>=0.2.1)"
    },
    "purpose": "Pin the four production-anchor digests cited in the AlgoVoi scope-conventions documentation so downstream emitter and verifier implementations have a byte-level reference to validate against. Any implementation claiming to interoperate with the AlgoVoi substrate at the action_ref layer MUST reproduce these digests verbatim for the given preimages.",
    "verification_recipe": [
      "1. For each vector, take preimage verbatim (the four fields in the order they appear in the vector).",
      "2. Canonicalise with RFC 8785 (any of the five reference impls listed in canonicalizer above).",
      "3. base64-encode the JCS bytes; it MUST equal expected_jcs_bytes_b64.",
      "4. SHA-256 the JCS bytes, lowercase hex; MUST equal expected_action_ref.",
      "5. Honour the pair invariants below: namespace-prefixed and unprefixed scopes with otherwise identical preimages MUST produce different digests."
    ],
    "pair_semantics": {
      "namespace_prefix_byte_load_bearing": "MUST differ (algovoi:compliance_screen != compliance_screen)",
      "cross_namespace_distinctness": "MUST differ (algovoi:compliance_screen != vauban:stark_settlement, etc.)",
      "field_order_invariance": "MUST be hash-identical under any field-order permutation of the preimage (JCS sorts object keys)"
    }
  },
  "fixed_preimage_fields": {
    "agent_id": "agent_alpha",
    "action_type": "screen",
    "timestamp_ms": 1716494400000
  },

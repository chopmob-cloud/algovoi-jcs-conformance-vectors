{
  "set": "task_ref_v1",
  "schema_version": 1,
  "description": "task_ref: deterministic content-addressed reference to an A2A Task delegation. sha256: + SHA-256(JCS({card_ref, created_at_ms, instructions_hash})). Recomputes offline with RFC 8785 + SHA-256, no JWS/JWKS. Binds agent identity (card_ref) to task instruction (instructions_hash) at a millisecond-precise instant.",
  "canonicalizer": "rfc8785-jcs + sha256, prefixed 'sha256:'",
  "source_spec": "AlgoVoi-A2A-Task (chopmob-cloud); open Apache-2.0 primitive",
  "construction": "task_ref = 'sha256:' + SHA-256(JCS({card_ref, created_at_ms, instructions_hash}))",
  "jcs_field_order": "card_ref, created_at_ms, instructions_hash (lexicographic)",

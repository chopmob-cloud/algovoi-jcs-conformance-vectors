{
  "set": "atb_trust_v1",
  "schema_version": "1",
  "description": "ATB verdict as a Keystone trust query. atb_trust_ref = trust_query_ref = sha256: + SHA-256(JCS({subject_refs, trust_outcome})). subject_refs = [passport_ref (or opaque agent_id_hash), then one atb_trial_ref per profile (alias of execution_ref)]. Byte-identical to the canonical trust_query_ref.",
  "canonicalizer": "rfc8785-jcs + sha256, prefixed 'sha256:'",
  "constructions": {
    "note": "Every reference is \"sha256:\" + SHA-256 over the RFC 8785 (JCS) canonical bytes of the object shown. Stated explicitly so this set is verifiable from its own contents, without importing any AlgoVoi package.",
    "challenge_ref": "ref(challenge)",
    "trial_ref": "ref({subject_ref, profile_id, challenge_ref, decision, evaluated_at_ms})",
    "atb_trust_ref": "ref({subject_refs, trust_outcome}) where subject_refs = [subject_ref] + [trial_ref per profile, in trial order]"
  },
  "fields": [
    "subject_refs",
    "trust_outcome"
  ],
  "trust_outcomes": [
    "TRUSTED",
    "PROVISIONAL",
    "INSUFFICIENT_EVIDENCE",
    "UNTRUSTED"
  ],
  "base_for_negatives": "tq-trusted",

{
  "schema_version": "1.0",
  "artefact_id": "retention-chain-conformance-v1",
  "published_at": "2026-06-17T00:00:00Z",
  "canonicalizer": "rfc8785@0.1.4 (Python) / canonicalize@2.0.0 (TypeScript) / stdlib SHA-256 + direct JCS construction (Go, Ruby, Rust, C#/.NET, Java, Kotlin)",
  "hash": "SHA-256, lowercase hex, prefixed sha256:",
  "anchored_to": {
    "primitive": "retention_chain_ref = \"sha256:\" + SHA-256(JCS({chain_seq, issuer_id, prev_receipt_hash, receipt_hash}))",
    "preimage_key_order": "JCS RFC 8785 lexicographic: chain_seq, issuer_id, prev_receipt_hash, receipt_hash",
    "genesis_condition": "chain_seq = 0 AND prev_receipt_hash = \"\"",
    "link_condition": "chain_seq > 0 AND prev_receipt_hash = receipt_hash of the immediately preceding receipt",
    "output_format": "\"sha256:\" + 64-character lowercase hex (71 chars total)",
    "spec_authorship": "AlgoVoi-authored; specified in IETF Internet-Draft draft-hopley-x402-retention-chain-00 (16 June 2026)",
    "spec_url": "https://datatracker.ietf.org/doc/draft-hopley-x402-retention-chain/"
  },
  "derivation": "Three vector groups exercising extended chain length, multi-issuer isolation, and seq-gap adversarial invariants. Part A: six consecutive records for issuer_id 'algovoi:compliance' (seq 0-5). Part B: four records demonstrating per-issuer chain independence -- issuer_a and issuer_b each process the same two receipts; their chain_refs diverge from seq 0. Part C: four records demonstrating seq-gap detection -- a proper 3-link chain (seq 0, 1, 2) paired with an adversarial gap vector at seq 2 (same receipt_hash, wrong prev_receipt_hash referencing seq 0 instead of seq 1). All receipt_hash values are SHA-256 of the UTF-8 encoding of the literal string shown in receipt_preimage.",
  "context": {
    "substrate_docs": "https://docs.algovoi.co.uk/retention-chain-substrate",
    "ietf_id": "draft-hopley-x402-retention-chain-00",
    "purpose": "Extended conformance corpus for the Retention Chain Substrate. Complements retention_chain_v0 (genesis + 2 links, single issuer). V1 adds: (A) 6-link extended chain to verify seq accumulation across deeper sequences; (B) multi-issuer isolation to verify issuer_id partitions chains; (C) seq-gap adversarial pair to verify implementations reject out-of-order prev_receipt_hash linkages. Any implementation claiming to implement the Retention Chain Substrate algorithm MUST reproduce all expected_chain_ref values verbatim for the given preimage inputs.",
    "verification_recipe": [
      "1. Compute receipt_hash_N = 'sha256:' + SHA-256(UTF-8(receipt_preimage)) for each vector.",
      "2. Construct preimage object with the four fields in the order shown.",
      "3. Canonicalise the preimage using RFC 8785 JCS. Verify expected_jcs_bytes_b64 matches.",
      "4. Compute SHA-256 of the canonical bytes. Prefix with 'sha256:'. MUST equal expected_chain_ref.",
      "5. For Part A: verify prev_receipt_hash of seq N equals receipt_hash of seq N-1.",
      "6. For Part B: verify issuer_a chain_refs != issuer_b chain_refs at every seq position.",
      "7. For Part C: verify proper_seq2 chain_ref != gap_seq2 chain_ref (pair_invariant_holds)."
    ],
    "part_a_invariants": {
      "genesis": "Vector 000: chain_seq=0, prev_receipt_hash='' (empty string)",
      "link_1": "Vector 001: prev_receipt_hash MUST equal vector 000's receipt_hash",
      "link_2": "Vector 002: prev_receipt_hash MUST equal vector 001's receipt_hash",
      "link_3": "Vector 003: prev_receipt_hash MUST equal vector 002's receipt_hash",
      "link_4": "Vector 004: prev_receipt_hash MUST equal vector 003's receipt_hash",
      "link_5": "Vector 005: prev_receipt_hash MUST equal vector 004's receipt_hash",
      "seq_increment": "Each chain_seq increments by exactly 1"
    },
    "part_b_invariants": {
      "issuer_isolation": "issuer_a and issuer_b chain_refs MUST differ at every shared seq position despite identical receipt_hash values",
      "issuer_a_seq0_ne_issuer_b_seq0": "sha256:52ef8da2c45178c5f2aef027d6c1e838d1f044dabb41596a639624cea5b57f83 != sha256:ced0cd4cc8d9446b17fca7ff57ed9508a9d5b50fce45a93d4a7e83779012810e",
      "issuer_a_seq1_ne_issuer_b_seq1": "sha256:683eb369f960cdea868414ebf8fb4d692af09afa9e5b94c91dc093448117a042 != sha256:7aa77a429f476fee8d09e6e2044b7f4c40277cbc250d9676110fb6fb68441b90"
    },
    "part_c_invariants": {
      "seq_gap_detection": "proper_seq2 and gap_seq2 share the same chain_seq (2) and receipt_hash but differ in prev_receipt_hash; their chain_refs MUST differ",
      "pair_invariant_holds": "sha256:9c589d9657146e062d4a91cf3a4bf92c98cbb6fcde0d509a84e020675ad8c7ea != sha256:2277ec545e5540a60b54c706b533c8962df61fb9a9c92de417d3808bd7be3cef"
    }
  },

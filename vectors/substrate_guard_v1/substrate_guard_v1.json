      "expected_code": "REJECT_TOO_MANY_KEYS"
    },
    {
      "id": "rj-over-array",
      "profile": {
        "name": "guard-receipt-v1",
        "max_bytes": 65536,
        "max_depth": 32,
        "max_object_keys": 256,
        "max_array_length": 4,
        "max_string_length": 8192,
        "max_total_nodes": 1000,
        "number_safety": true
      },
      "value": [
        1,
        2,
        3,
        4,
        5
      ],
      "expected_code": "REJECT_OVER_ARRAY"
    },
    {
      "id": "rj-over-depth",
      "profile": {
        "name": "guard-receipt-v1",
        "max_bytes": 65536,
        "max_depth": 3,
        "max_object_keys": 256,
        "max_array_length": 1024,
        "max_string_length": 8192,
        "max_total_nodes": 1000,
        "number_safety": true
      },
      "value": {
        "a": {
          "a": {
            "a": {
              "a": 1
            }
          }
        }
      },
      "expected_code": "REJECT_OVER_DEPTH"
    },
    {
      "id": "rj-over-nodes",
      "profile": {
        "name": "guard-receipt-v1",
        "max_bytes": 65536,
        "max_depth": 32,
        "max_object_keys": 256,
        "max_array_length": 1000,
        "max_string_length": 8192,
        "max_total_nodes": 5,
        "number_safety": true
      },
      "value": [
        1,
        2,
        3,
        4,
        5
      ],
      "expected_code": "REJECT_OVER_NODES"
    },
    {
      "id": "rj-unsafe-int",
      "profile": {
        "name": "guard-receipt-v1",
        "max_bytes": 65536,
        "max_depth": 32,
        "max_object_keys": 256,
        "max_array_length": 1024,
        "max_string_length": 8192,
        "max_total_nodes": 4096,
        "number_safety": true
      },
      "value": 9007199254740992,
      "expected_code": "REJECT_UNSAFE_NUMBER"
    },
    {
      "id": "rj-over-size",
      "profile": {
        "name": "guard-receipt-v1",
        "max_bytes": 200,
        "max_depth": 32,
        "max_object_keys": 256,
        "max_array_length": 1000,
        "max_string_length": 1000,
        "max_total_nodes": 1000,
        "number_safety": true
      },
      "value": [
        "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
        "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
        "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
        "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
        "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
        "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
        "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
        "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
        "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
        "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
      ],
      "expected_code": "REJECT_OVER_SIZE"
    }
  ],
  "invariants": [
    {
      "id": "inv-key-order",
      "note": "reordered profile keys -> identical profile_ref (JCS sorts)"
    }
  ]
}